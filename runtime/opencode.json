{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "persona",
  "agent": {
    "persona": {
      "description": "chromly case agent - Nini persona (persona.txt) as system prompt",
      "mode": "primary",
      "prompt": "{file:./persona.txt}"
    },
    "intel": {
      "description": "intel lane - review patch-diff V8, sinh variant hypothesis (PLAN §5.3)",
      "mode": "subagent",
      "prompt": "{file:./persona.txt}"
    },
    "triage": {
      "description": "triage lane - crash/ASAN → classify + score (PLAN §5.4)",
      "mode": "subagent",
      "prompt": "{file:./persona.txt}"
    },
    "analyst": {
      "description": "analyst lane - root cause + source map (PLAN §4.3)",
      "mode": "subagent",
      "prompt": "{file:./persona.txt}"
    },
    "exploit-dev": {
      "description": "exploit lane - primitive ladder + PoC (PLAN §5.9)",
      "mode": "subagent",
      "prompt": "{file:./persona.txt}"
    }
  },
  "mcp": {
    "ida": {
      "type": "local",
      "command": ["uvx", "--exclude-newer=1s", "ida-mcp", "stdio", "--agent=opencode"],
      "enabled": true
    }
  }
}
