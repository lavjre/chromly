# chromly build config — calibration revert-fix (M3-03). Target: d8.
# Giống asan nhưng out dir riêng (out/calib) để không đè out/asan. + dcheck cho bug class rộng.
# target: d8
is_debug = false
symbol_level = 2
use_lld = true
v8_monolithic = true
v8_use_external_startup_data = false
